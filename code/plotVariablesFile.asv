dirpath = "..\figures\ItaSaiDistances1Inputs\Variables\";


clear data;
files = dir(dirpath);
titles = string();
index = 1;


for i = 3 : length(files)
    temp = load(strcat(dirpath, files(i).name));
    data(index, 1) = temp;
    titles(index) = files(i).name;
    index = index +1;
end

