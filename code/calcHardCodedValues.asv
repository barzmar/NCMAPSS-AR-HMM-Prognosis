function [row_mean, row_Std] = calcHardCodedValues()

for unit = [1,2,5,6,8]
    for f = 1 : length(unitsFlights(unit))
        if exist("data","var")
            data = horzcat(data, unitsFlights(unit).flights(f).Value(:,:));
        else
            data = unitsFlights(unit).flights(f).Value(:,:);
        end
    end
end

row_mean = mean(data, 2);
row_Std  = std(data, 0, 2);